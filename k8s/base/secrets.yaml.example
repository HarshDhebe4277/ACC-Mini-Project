apiVersion: v1
kind: Secret
metadata:
  name: campus-events-secrets
  namespace: campus-events
type: Opaque
stringData:
  # Supabase Backend & Database Credentials
  SUPABASE_URL: "https://your-supabase-project.supabase.co"
  SUPABASE_ANON_KEY: "your-supabase-anon-key"
  SUPABASE_KEY: "your-supabase-anon-key"
  SUPABASE_SERVICE_ROLE_KEY: "your-supabase-service-role-key"
  SUPABASE_JWT_SECRET: "your-supabase-jwt-secret-min-32-chars"
  JWT_SECRET_KEY: "your-supabase-jwt-secret-min-32-chars"

  # Frontend Supabase Client Credentials
  NEXT_PUBLIC_SUPABASE_URL: "https://your-supabase-project.supabase.co"
  NEXT_PUBLIC_SUPABASE_ANON_KEY: "your-supabase-anon-key"

  # Mistral AI Engine API Key
  MISTRAL_API_KEY: "your-mistral-api-key"

  # Digital Pass HMAC Signing Secret (min 32 characters)
  QR_HMAC_SECRET: "your-secure-qr-hmac-secret-min-32-chars"
